# Vercel → Project Settings → Environment Variables (Production)
# Copy the same values into client/.env for local `next dev`.

# Required in production — signs CMS session cookies
CMS_SESSION_SECRET=change-me-to-a-long-random-string

# Strapi CMS (Railway) — public HTTPS URL of the Strapi service
STRAPI_URL=https://your-strapi.up.railway.app
# Strapi Admin → Settings → API Tokens → Full access (needed for /admin/investors writes)
STRAPI_API_TOKEN=

# Railway Storage Bucket (S3-compatible) — from Bucket → Credentials
# Endpoint is usually https://storage.railway.app (or https://t3.storageapi.dev)
AWS_ENDPOINT=https://storage.railway.app
AWS_REGION=auto
AWS_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
# Optional alias if you pasted Railway's default name instead:
# AWS_SECRET_ACCESS_KEY=
