# Server
HOST=0.0.0.0
PORT=1337

# Secrets (generate fresh values for production — never reuse these placeholders)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — Railway Postgres
# On Railway: prefer Variable References from the Postgres service, e.g.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Internal host (*.railway.internal) only works between Railway services.
# For local Strapi → Railway DB, use the public TCP proxy URL from Railway → Postgres → Connect.
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway
DATABASE_HOST=postgres.railway.internal
DATABASE_PORT=5432
DATABASE_NAME=railway
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=PASSWORD
DATABASE_SSL=false
DATABASE_SCHEMA=public

# Railway Storage Bucket — same names as Railway Variables tab
AWS_ENDPOINT_URL=https://t3.storageapi.dev
AWS_DEFAULT_REGION=auto
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_ACL=private
AWS_SIGNED_URL_EXPIRES=3600
